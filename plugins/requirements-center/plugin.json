{
  "name": "requirements-center",
  "displayName": "需求中心",
  "version": "1.4.4",
  "providerEntry": "server/app.py:requirements_plugin_info",
  "frontendEntry": "web/requirements-center.js",
  "styleEntry": "web/style.css",
  "description": "兼容 SWTool 需求中心的提交、讨论、状态和运维管理插件",
  "api": "/api/tickets",
  "legacyApi": "/issues",
  "sharedStorage": "issues",
  "upstream": "SWTool requirements-center",
  "upstreamAssets": [
    "tickets.swtool.html",
    "tickets.swtool.js"
  ],
  "activation": "upload-auto-activate",
  "federation": {
    "protocol": "swtool-requirements/1",
    "identity": "/api/requirements/identity",
    "workspace": "web/requirements-hub.html",
    "keyManagement": "/api/requirements/key"
  },
  "sourceDownload": "/api/requirements/source",
  "guide": "web/requirements-guide.html",
  "pluginPackage": "/admin/plugins/requirements-center/package",
  "hotReload": true
}
